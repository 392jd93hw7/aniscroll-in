{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aniscroll-v2",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
