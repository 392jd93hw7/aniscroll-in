# Browser-safe Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
# Server-only keys: never prefix these with VITE_ or commit real values.
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
# Comma-separated exact origins allowed to mint session tokens for this API.
# Add your exact forwarded Codespaces URL here when testing in Codespaces.
CLERK_AUTHORIZED_PARTIES=https://aniscroll.in,http://localhost:8443
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Existing MAL proxy variable if using MAL API features.
MAL_CLIENT_ID=replace_with_your_mal_client_id
